async def test_requires_authentication(http: httpx.AsyncClient) -> None:
    response = await http.get(URL, headers={"Authorization": ""})
    assert response.status_code == 401
    assert response.json()["errorKey"] == "common.unauthorized"


async def test_crud(http: httpx.AsyncClient) -> None:
    response = await http.post(URL, json={"name": "first"})
    assert response.status_code == 201
    created = response.json()["data"]
    assert created["name"] == "first"
    assert created["deletedAt"] is None
    item = f"{URL}/{created['id']}"

    listed = (await http.get(URL)).json()["data"]
    assert [entity["id"] for entity in listed["items"]] == [created["id"]]
    assert (listed["total"], listed["page"], listed["pageSize"]) == (1, 1, 20)
    assert (await http.get(item)).json()["data"] == created

    updated = (await http.put(item, json={"name": "second"})).json()["data"]
    assert updated["name"] == "second"

    assert (await http.delete(item)).json() == {"code": 0, "message": "ok", "data": None}
    missing = await http.get(item)
    assert missing.status_code == 404
    assert missing.json()["errorKey"] == "common.notFound"


async def test_validation(http: httpx.AsyncClient) -> None:
    response = await http.post(URL, json={"name": ""})
    assert response.status_code == 422
    assert response.json()["data"]["errors"][0]["field"] == "name"
    invalid_id = await http.get(f"{URL}/abc")
    assert invalid_id.status_code == 422
    assert invalid_id.json()["data"]["errors"][0]["field"] == "path.id"
