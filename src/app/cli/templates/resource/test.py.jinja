async def test_requires_authentication(http: httpx.AsyncClient) -> None:
    response = await http.get(URL, headers={"Authorization": ""})
    assert response.json() == {"code": 401, "message": "Unauthorized", "data": None}


async def test_crud(http: httpx.AsyncClient) -> None:
    created = (await http.post(URL, json={"name": "first"})).json()["data"]
    assert created["name"] == "first"
    assert created["deletedAt"] is None
    item = f"{URL}/{created['id']}"

    listed = (await http.get(URL)).json()["data"]
    assert [entity["id"] for entity in listed["list"]] == [created["id"]]
    assert (listed["total"], listed["page"], listed["limit"]) == (1, 1, 10)
    assert (await http.get(item)).json()["data"] == created

    updated = (await http.put(item, json={"name": "second"})).json()["data"]
    assert updated["name"] == "second"

    assert (await http.delete(item)).json() == {"code": 200, "message": "success"}
    missing = await http.get(item)
    assert missing.json() == {
        "code": 404,
        "message": "{{ class_name }} not found",
        "data": None,
    }


async def test_validation(http: httpx.AsyncClient) -> None:
    response = await http.post(URL, json={"name": ""})
    assert response.status_code == 422
    assert list(response.json()["data"]) == ["name"]
    invalid_id = await http.get(f"{URL}/abc")
    assert invalid_id.json() == {
        "code": 400,
        "message": "Bad request",
        "data": {"id": "Invalid id"},
    }
