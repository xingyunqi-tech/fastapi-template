from typing import TYPE_CHECKING, Final

from sqlalchemy import delete, func, select

from app.modules.{{ package }}.models import {{ class_name }}Model

if TYPE_CHECKING:
    from collections.abc import Sequence
    from uuid import UUID

    from sqlalchemy.ext.asyncio import AsyncSession

    from app.common.pagination import SortField

SORTABLE: Final = {
    "createdAt": {{ class_name }}Model.created_at,
    "updatedAt": {{ class_name }}Model.updated_at,
    "name": {{ class_name }}Model.name,
}


class {{ class_name }}Repository:
    def __init__(self, session: AsyncSession) -> None:
        self.session = session

    async def find_page(
        self, owner_id: str, *, sort: Sequence[SortField], offset: int, limit: int
    ) -> tuple[list[{{ class_name }}Model], int]:
        owned = {{ class_name }}Model.owner_id == owner_id
        order = [
            SORTABLE[field.field].desc() if field.descending else SORTABLE[field.field].asc()
            for field in sort
        ]
        rows = await self.session.scalars(
            select({{ class_name }}Model)
            .where(owned)
            .order_by(*order, {{ class_name }}Model.id)
            .offset(offset)
            .limit(limit)
        )
        total = await self.session.scalar(
            select(func.count()).select_from({{ class_name }}Model).where(owned)
        )
        return list(rows), int(total or 0)

    async def find_owned(self, owner_id: str, entity_id: UUID) -> {{ class_name }}Model | None:
        return await self.session.scalar(
            select({{ class_name }}Model).where(
                {{ class_name }}Model.id == entity_id, {{ class_name }}Model.owner_id == owner_id
            )
        )

    async def add(self, entity: {{ class_name }}Model) -> {{ class_name }}Model:
        self.session.add(entity)
        await self.session.flush()
        await self.session.refresh(entity)
        return entity

    async def save(self, entity: {{ class_name }}Model) -> {{ class_name }}Model:
        await self.session.flush()
        await self.session.refresh(entity)
        return entity

    async def delete(self, entity: {{ class_name }}Model) -> None:
        await self.session.delete(entity)
        await self.session.flush()

    async def delete_by_owner(self, owner_id: str) -> None:
        await self.session.execute(
            delete({{ class_name }}Model).where({{ class_name }}Model.owner_id == owner_id)
        )
