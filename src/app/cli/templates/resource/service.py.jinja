from typing import TYPE_CHECKING

from app.common.errors import AppError
from app.modules.{{ package }}.models import {{ class_name }}Model
from app.modules.{{ package }}.repository import {{ class_name }}Repository

if TYPE_CHECKING:
    from collections.abc import Sequence
    from uuid import UUID

    from sqlalchemy.ext.asyncio import AsyncSession

    from app.common.pagination import SortField
    from app.modules.{{ package }}.schemas import Create{{ class_name }}Request, Update{{ class_name }}Request


class {{ class_plural }}Service:
    def __init__(self, session: AsyncSession, owner_id: UUID) -> None:
        self.repository = {{ class_name }}Repository(session)
        self.owner_id = str(owner_id)

    async def find_page(
        self, *, sort: Sequence[SortField], offset: int, limit: int
    ) -> tuple[list[{{ class_name }}Model], int]:
        return await self.repository.find_page(self.owner_id, sort=sort, offset=offset, limit=limit)

    async def get(self, entity_id: UUID) -> {{ class_name }}Model:
        entity = await self.repository.find_owned(self.owner_id, entity_id)
        if entity is None:
            raise AppError("common.notFound")
        return entity

    async def create(self, body: Create{{ class_name }}Request) -> {{ class_name }}Model:
        return await self.repository.add({{ class_name }}Model(owner_id=self.owner_id, name=body.name))

    async def update(self, entity_id: UUID, body: Update{{ class_name }}Request) -> {{ class_name }}Model:
        entity = await self.get(entity_id)
        if body.name is not None:
            entity.name = body.name
        return await self.repository.save(entity)

    async def delete(self, entity_id: UUID) -> None:
        await self.repository.delete(await self.get(entity_id))
