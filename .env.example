APP_ENV=development
APP_PORT=3000
APP_NAME="FastAPI API"
APP_DEFAULT_LOCALE=zh
APP_FRONTEND_URL=http://localhost:3000
BACKEND_DOMAIN=http://localhost:3000
TRUST_PROXY=0
DOCS_ENABLED=true
# 生产环境允许的跨域来源，逗号分隔
CORS_ORIGINS=
BODY_LIMIT=1MiB
WEB_CONCURRENCY=1

# libpq URI；sslmode 取 disable / allow / prefer / require / verify-ca / verify-full
DATABASE_URL=postgresql://root:secret@localhost:5432/api?sslmode=disable
# 本服务独占的 schema，迁移时自动创建
DATABASE_SCHEMA=public
# 每进程连接池大小与获取连接超时
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT=10s
# docker compose 的 migrate 服务在迁移后是否执行 app seed
RUN_SEEDS=false

# 签发方：iss / aud 与 Ed25519 签名私钥（PEM，可用 \n 写成一行；`app keys generate` 生成）
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=api
AUTH_SIGNING_KEY=
# 轮换期间仍接受的旧公钥（PEM，可多个）
AUTH_VERIFY_KEYS=
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h
PASSWORD_HASH_CONCURRENCY=2
# 生产 `app seed` 创建的管理员；未设置时不创建
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Api <noreply@example.com>"
# none / starttls / tls
MAIL_TLS=none

# local / s3 / s3-presigned
FILE_DRIVER=local
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
AWS_S3_REGION=
AWS_DEFAULT_S3_BUCKET=
AWS_S3_ENDPOINT=
# 仅在配置了 AWS_S3_ENDPOINT 时生效：MinIO 为 true，阿里云 OSS 为 false
AWS_S3_FORCE_PATH_STYLE=true
FILE_IMAGE_MAX_SIZE=5242880
FILE_PRIVATE_IMAGE_MAX_SIZE=10485760
FILE_CONTENT_IMAGE_MAX_SIZE=5242880
FILE_AUDIO_MAX_SIZE=20971520
FILE_IMPORT_MAX_SIZE=52428800
FILE_EXPORT_MAX_SIZE=20971520

THROTTLE_ENABLED=false
THROTTLE_TTL=60
THROTTLE_LIMIT=100

METRICS_ENABLED=true
METRICS_PATH=metrics
# 至少 16 个字符；留空时生产环境拒绝访问 /metrics 与 /api/v1/health
METRICS_TOKEN=
# 多 worker 时设置为可写目录（须为进程环境变量，.env 中无效）；API 与 taskiq worker 进程须共享该目录，`python -m app` 启动时清空其中的旧 *.db
# PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# fatal / error / warn / info / debug / trace / silent，默认生产 info、其它 debug
LOG_LEVEL=
LOG_PRETTY_PRINT=

SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_CODE_EXPIRES=300
SMS_CODE_LENGTH=6
SMS_ENDPOINT=dysmsapi.aliyuncs.com
# true 时只把验证码写入日志，不调用阿里云
SMS_MOCK_MODE=true
SMS_MAX_ATTEMPTS=5
SMS_RESEND_INTERVAL=60

WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MINI_PROGRAM_STATE=formal

ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_SIGN_TYPE=RSA2
ALIPAY_CHARSET=utf-8
ALIPAY_SANDBOX=false

SENTRY_DSN=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
