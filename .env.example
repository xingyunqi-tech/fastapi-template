APP_ENV=development
APP_PORT=3000
APP_DEFAULT_LOCALE=zh
APP_FRONTEND_URL=http://localhost:3000
# 可信代理层数（如 1）或 CIDR 列表（如 10.0.0.0/8,fd00::/8）
TRUSTED_PROXIES=0
DOCS_ENABLED=true
# 生产环境允许的跨域来源，逗号分隔
CORS_ORIGINS=
BODY_LIMIT=1MiB
# OTEL_METRICS_EXPORTER=prometheus 时只能为 1
WEB_CONCURRENCY=1
# 日志 service 字段、OpenTelemetry service.name 与 Redis 键前缀
OTEL_SERVICE_NAME=api

# libpq URI；sslmode 取 disable / allow / prefer / require / verify-ca / verify-full；签发方必填，验证方可空
DATABASE_URL=postgresql://root:secret@localhost:5432/api?sslmode=disable
# 本服务独占的 schema，迁移时自动创建
DATABASE_SCHEMA=public
# 每进程连接池大小与获取连接超时
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT=10s
# docker compose 的 migrate 服务在迁移后是否执行 app seed
RUN_SEEDS=false

# iss / aud；签发方设置 AUTH_SIGNING_KEY（Ed25519 私钥 PEM，可用 \n 写成一行；`app keys generate` 生成），
# 验证方改设 AUTH_JWKS_URL（签发方的 /.well-known/jwks.json），二者只能设置一个
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=api
AUTH_SIGNING_KEY=
AUTH_JWKS_URL=
# 轮换期间仍接受的旧公钥（PEM，可多个）
AUTH_VERIFY_KEYS=
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h
PASSWORD_HASH_CONCURRENCY=2
# 生产 `app seed` 创建的管理员；未设置时不创建
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# 未设置时缓存、锁、限流、吊销、短信计数与队列用进程内实现；生产必填
REDIS_URL=

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Api <noreply@example.com>"
# none / starttls / tls
MAIL_TLS=none

# local：签名地址经 getFileContent 输出；s3：预签名 GET；签发方必填，验证方为空时不挂载 files
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/files
STORAGE_URL_TTL=10m
# local 的签名密钥，生产与验证方必填；签发方未设置时由 AUTH_SIGNING_KEY 派生
STORAGE_URL_SECRET=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
# 未设置时使用默认凭据链
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MinIO 为 true
S3_FORCE_PATH_STYLE=false

# 私有默认限流规则；约定 §11.6 的共享规则不可配置
RATE_LIMIT_DEFAULT=10/s,burst=20

# none / log / redis_stream；redis_stream 时 stream 名必填，配置了数据库的验证方 worker 消费 user.deleted
EVENTS_TRANSPORT=log
EVENTS_REDIS_STREAM=

# 至少 16 个字符；OTEL_METRICS_EXPORTER=prometheus 时生产必填
METRICS_TOKEN=

# debug / info / warn / error，默认生产 info、其他 debug；json / text，默认生产 json、其他 text
LOG_LEVEL=
LOG_FORMAT=

# 可选 provider
# log：验证码只写日志（生产不输出验证码）；aliyun：需配齐下列 SMS_ALIYUN_*
SMS_PROVIDER=log
SMS_ALIYUN_ACCESS_KEY_ID=
SMS_ALIYUN_ACCESS_KEY_SECRET=
SMS_ALIYUN_SIGN_NAME=
SMS_ALIYUN_TEMPLATE_CODE=
SMS_ALIYUN_ENDPOINT=dysmsapi.aliyuncs.com

# AppID 与密钥配齐即启用 wechat_miniapp / wechat_app
WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_SECRET=
WECHAT_APP_APP_ID=
WECHAT_APP_SECRET=

# AppID、应用私钥（PKCS#8）与支付宝公钥配齐即启用 alipay
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_SIGN_TYPE=RSA2
ALIPAY_CHARSET=utf-8
ALIPAY_SANDBOX=false

SENTRY_DSN=
# prometheus（API 挂载 /metrics，worker / scheduler 监听下列端口）/ otlp / none
OTEL_METRICS_EXPORTER=prometheus
OTEL_EXPORTER_PROMETHEUS_HOST=0.0.0.0
OTEL_EXPORTER_PROMETHEUS_PORT=9464
# 未设置 OTEL_TRACES_EXPORTER 时，配置了 OTLP 端点才导出链路
OTEL_TRACES_EXPORTER=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SDK_DISABLED=false
