APP_ENV=development
APP_PORT=3000
APP_NAME="FastAPI API"
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
FRONTEND_DOMAIN=http://localhost:3000
BACKEND_DOMAIN=http://localhost:3000
TRUST_PROXY=0
SWAGGER_ENABLED=true
WEB_CONCURRENCY=1

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=root
DATABASE_PASSWORD=secret
DATABASE_NAME=api
DATABASE_MAX_CONNECTIONS=80
WORKER_DATABASE_MAX_CONNECTIONS=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=true
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=
DATABASE_URL=
# alembic（默认）或 external（与 nestjs 共库，表结构由 nestjs 迁移管理）
DB_SCHEMA_OWNER=alembic
# docker compose 的 migrate 服务在迁移后是否执行 app seed
RUN_SEEDS=false

AUTH_JWT_SECRET=secret
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=secret_for_refresh
AUTH_REFRESH_TOKEN_EXPIRES_IN=3650d
AUTH_FORGOT_SECRET=secret_for_forgot
AUTH_FORGOT_TOKEN_EXPIRES_IN=30m
AUTH_CONFIRM_EMAIL_SECRET=secret_for_confirm_email
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d
# argon2id（默认）或 bcrypt（与 nestjs 共库时）
PASSWORD_HASHER=argon2id
PASSWORD_HASH_CONCURRENCY=2

REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_IGNORE_TLS=true
MAIL_SECURE=false
MAIL_REQUIRE_TLS=false
MAIL_DEFAULT_EMAIL=noreply@example.com
MAIL_DEFAULT_NAME=Api

# local / s3 / s3-presigned
FILE_DRIVER=local
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
AWS_S3_REGION=
AWS_DEFAULT_S3_BUCKET=
AWS_S3_ENDPOINT=
# 仅在配置了 AWS_S3_ENDPOINT 时生效：MinIO 为 true，阿里云 OSS 为 false
AWS_S3_FORCE_PATH_STYLE=true
FILE_IMAGE_MAX_SIZE=5242880
FILE_PRIVATE_IMAGE_MAX_SIZE=10485760
FILE_CONTENT_IMAGE_MAX_SIZE=5242880
FILE_AUDIO_MAX_SIZE=20971520
FILE_IMPORT_MAX_SIZE=52428800
FILE_EXPORT_MAX_SIZE=20971520

THROTTLE_ENABLED=false
THROTTLE_TTL=60
THROTTLE_LIMIT=100

METRICS_ENABLED=true
METRICS_PATH=metrics
# 至少 16 个字符；留空时生产环境拒绝访问 /metrics 与 /api/v1/health
METRICS_TOKEN=
# 多 worker 时设置为可写目录（须为进程环境变量，.env 中无效）；API 与 taskiq worker 进程须共享该目录，`python -m app` 启动时清空其中的旧 *.db
# PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# fatal / error / warn / info / debug / trace / silent，默认生产 info、其它 debug
LOG_LEVEL=
LOG_PRETTY_PRINT=

SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_CODE_EXPIRES=300
SMS_CODE_LENGTH=6
SMS_ENDPOINT=dysmsapi.aliyuncs.com
# true 时只把验证码写入日志，不调用阿里云
SMS_MOCK_MODE=true
SMS_MAX_ATTEMPTS=5
SMS_RESEND_INTERVAL=60

WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 订阅消息跳转的小程序版本：developer / trial / formal
WECHAT_MINI_PROGRAM_STATE=formal
# 订阅消息模板（支付成功），模板 ID 需与小程序端 VITE_WX_TMPL_ORDER_PAID 一致
# 字段映射格式：业务字段:模板字段key，可用业务字段 orderNo / amount / paidAt
WECHAT_SUBSCRIBE_ORDER_PAID_TEMPLATE_ID=
WECHAT_SUBSCRIBE_ORDER_PAID_FIELDS=orderNo:character_string1,amount:amount2,paidAt:time3

ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_SIGN_TYPE=RSA2
ALIPAY_CHARSET=utf-8
ALIPAY_SANDBOX=false

SENTRY_DSN=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
